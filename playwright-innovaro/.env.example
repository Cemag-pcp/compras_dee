# Offsets de pixel RELATIVOS ao container real da grade Especificação
# (calculado em runtime via getBoundingClientRect — robusto a mudanças de
# scroll/altura do painel acima; só o offset interno precisa de calibração
# visual). Deixe INNOVARO_SPEC_FILL_MAX_ITERATIONS comentado/vazio para usar
# o recordCount da grid como limite (recomendado).
INNOVARO_SPEC_FIRST_ROW_OFFSET_X=537
INNOVARO_SPEC_FIRST_ROW_OFFSET_Y=113
# INNOVARO_SPEC_FILL_MAX_ITERATIONS=10

# Ícone "três pontinhos" (⋮) no cabeçalho da grade Especificação (offset
# relativo ao mesmo container). O item "Exibir chaves" do menu que abre é
# selecionado via Enter (primeiro item), não por coordenada — o menu pode
# abrir pra cima ou pra baixo do ícone dependendo do espaço na tela.
INNOVARO_SPEC_OPTIONS_MENU_OFFSET_X=116
INNOVARO_SPEC_OPTIONS_MENU_OFFSET_Y=41

# Cabeçalho da coluna "Chave" (só existe após exibirChavesEspecificacao),
# offset relativo ao mesmo container. Um clique único ordena por ela.
INNOVARO_SPEC_CHAVE_HEADER_OFFSET_X=85
INNOVARO_SPEC_CHAVE_HEADER_OFFSET_Y=91

# Checkbox da 1a linha de dados e altura de cada linha (clique físico real
# necessário para marcar/desmarcar — grid.emit('recordSelect', ...) não
# funciona depois que a grade foi ordenada por uma coluna).
INNOVARO_SPEC_CHECKBOX_OFFSET_X=17
INNOVARO_SPEC_CHECKBOX_OFFSET_Y=113
INNOVARO_SPEC_ROW_HEIGHT=23

# Botão "−" (excluir os registros marcados) no cabeçalho da grade
# Especificação, offset relativo ao mesmo container.
INNOVARO_SPEC_DELETE_BUTTON_OFFSET_X=57
INNOVARO_SPEC_DELETE_BUTTON_OFFSET_Y=16

# Google Sheets (service account com acesso de Editor às planilhas no Drive)
GOOGLE_SERVICE_ACCOUNT_PATH=../service_account_cemag.json
